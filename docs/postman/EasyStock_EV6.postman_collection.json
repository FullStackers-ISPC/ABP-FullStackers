      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/usuarios/login/",
        "body": {
          "mode": "raw",
          "raw": "{\"email\": \"admin@easystock.com\", \"password\": \"admin1234\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Campo rol', () => pm.expect(pm.response.json()['rol']).to.eql(\"admin\"));"
            ]
