{
  "info": {
    "name": "EasyStock EV6 — Calidad API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo entorno local de pruebas. Ejecutar completa y en orden. Requiere roles 1/2 y cuentas demo. Genera categoría, producto QA y tres movimientos persistentes para auditar stock; no borra historial. No usar en producción. Base actual SQLite: repetir sobre MySQL antes de entrega."
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "nonce",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === 'Usuarios — Login administrador') pm.collectionVariables.set('nonce', String(Date.now()));"
        ]
      }
    }
  ],
